########################################################################
# Podman Compose Stack - Environment Variables Template
# Copy this file to .env and set your secure values.
# NEVER commit your actual .env file or real secrets to Git.
########################################################################

# Timezone
TZ=Asia/Kolkata

########################################################################
# Database Tier
########################################################################
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=app

MONGO_USER=mongo
MONGO_PASSWORD=mongo_secure_password

VALKEY_PASSWORD=valkey_secure_password

NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secure_password

CLICKHOUSE_DB=default
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse_secure_password

MEILI_MASTER_KEY=meili_master_key_min_16_chars

ES_JAVA_OPTS=-Xms1g -Xmx1g

########################################################################
# Messaging & Streaming
########################################################################
RABBITMQ_USER=rabbit
RABBITMQ_PASSWORD=rabbit_secure_password

KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

########################################################################
# Object Storage
########################################################################
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_secure_password

########################################################################
# Identity & Access Management (Keycloak & LDAP)
########################################################################
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak_secure_admin_password

LDAP_ORGANISATION=MyOrg
LDAP_DOMAIN=myorg.local
LDAP_ADMIN_PASSWORD=ldap_admin_secure_password
LDAP_CONFIG_PASSWORD=ldap_config_secure_password
LDAP_READONLY_USER=readonly
LDAP_READONLY_PASSWORD=ldap_readonly_secure_password

########################################################################
# API Gateway & Kong
########################################################################
KONG_DATABASE=kong
KONGA_TOKEN_SECRET=konga_random_jwt_secret_token

########################################################################
# Secrets Management: OpenBao (Vault)
########################################################################
OPENBAO_ROOT_TOKEN=openbao_root_dev_token
# AppRole Authentication credentials (for automated clients like OpenTofu)
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=

########################################################################
# Observability & Monitoring
########################################################################
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_secure_admin_password

########################################################################
# Application Databases
########################################################################
N8N_DATABASE=n8n
LANGFUSE_DATABASE=langfuse
HAWKBIT_DATABASE=hawkbit
APICURIO_DB=apicurio

########################################################################
# Apicurio Registry
########################################################################
APICURIO_USER=postgres
APICURIO_PASSWORD=postgres_secure_password

########################################################################
# OpenTofu Infrastructure Automation
########################################################################
OPENTOFU_DIR=../opentofu

########################################################################
# AI Services
########################################################################
OLLAMA_HOST=http://ol:11434
